# 请生成随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(32))"
CAMPUS_MOBILE_API_TOKEN=

# 填写反向代理域名或局域网 IP；不要写协议、端口、路径或 *。
CAMPUS_SERVER_ALLOWED_HOSTS=127.0.0.1,localhost
CAMPUS_SERVER_BIND_IP=127.0.0.1
CAMPUS_SERVER_PORT=8000
CAMPUS_SERVER_MAX_CONCURRENT_CHATS=4

# 留空时 DeepSeek planner 自动回退到本地 Rule planner。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 默认使用本地模拟校园业务数据；接真实系统时再单独配置 official 模式。
CAMPUS_BUSINESS_API_MODE=mock
